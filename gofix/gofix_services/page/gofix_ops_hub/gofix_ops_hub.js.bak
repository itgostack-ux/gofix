// GoFix Ops Hub — Frontend
// Step-by-step repair workflow: Ticket Queue → Analysis → Confirm → Solutions → Assign → Repair

frappe.pages["gofix-ops-hub"].on_page_load = function (wrapper) {
	const page = frappe.ui.make_app_page({
		parent: wrapper,
		title: "GoFix Ops Hub",
		single_column: true,
	});
	frappe.gofix_ops_hub = new GoFixOpsHub(page);
};

// ─────────────────────────────────────────────────────────────────────────────
// Stage meta
// ─────────────────────────────────────────────────────────────────────────────
const STAGES = [
	{ key: "analysis",  label: "Analysis",     icon: "fa-search",       color: "#3b82f6" },
	{ key: "confirm",   label: "Confirm",       icon: "fa-check-circle", color: "#8b5cf6" },
	{ key: "solutions", label: "Solutions",     icon: "fa-bolt",         color: "#f59e0b" },
	{ key: "assign",    label: "Assign",        icon: "fa-user-plus",    color: "#10b981" },
	{ key: "repair",    label: "Repair",        icon: "fa-wrench",       color: "#ef4444" },
	{ key: "qc",        label: "QC",            icon: "fa-check-square-o", color: "#6366f1" },
	{ key: "invoice",   label: "Invoice",       icon: "fa-file-text-o",  color: "#10b981" },
];

const STAGE_ORDER = STAGES.map(s => s.key);

const PRIORITY_COLORS = {
	Urgent: "#dc2626", High: "#ef4444", Medium: "#f59e0b", Low: "#10b981",
};

const STAGE_BADGE = {
	analysis:  { label: "Analysis",   cls: "goh-badge-blue" },
	confirm:   { label: "Confirm",    cls: "goh-badge-purple" },
	solutions: { label: "Solutions",  cls: "goh-badge-yellow" },
	assign:    { label: "Assign",     cls: "goh-badge-green" },
	repair:    { label: "Repair",     cls: "goh-badge-red" },
	qc:        { label: "QC",         cls: "goh-badge-purple" },
	invoice:   { label: "Invoice",    cls: "goh-badge-green" },
	rework:    { label: "QC Fail",    cls: "goh-badge-red" },
	done:      { label: "Done",       cls: "goh-badge-done" },
	closed:    { label: "Closed",     cls: "goh-badge-muted" },
	draft:     { label: "Draft",      cls: "goh-badge-muted" },
};

// ─────────────────────────────────────────────────────────────────────────────
class GoFixOpsHub {
	constructor(page) {
		this.page      = page;
		this.parent    = $(page.body);
		this.selected  = null;   // currently selected SR name
		this.detail    = null;   // current detail object
		this.queue     = [];     // full queue list
		this.filters   = {
			warehouse:    null,
			search:       "",
			date_from:    frappe.datetime.add_days(frappe.datetime.nowdate(), -60),
			date_to:      frappe.datetime.nowdate(),
			stage_filter: "active",
		};
		this.setup();
	}

	setup() {
		this._build_toolbar();
		this._build_layout();
		this._load_queue();
		frappe.realtime.on("job_assignment_update", () => this._refresh_all());
	}

	// ── Toolbar ────────────────────────────────────────────────────────────────

	_build_toolbar() {
		this.page.add_field({
			fieldname: "date_from", label: __("From"), fieldtype: "Date",
			default: this.filters.date_from,
			change: () => {
				this.filters.date_from = this.page.fields_dict.date_from.get_value();
				this._load_queue();
			},
		});
		this.page.add_field({
			fieldname: "date_to", label: __("To"), fieldtype: "Date",
			default: this.filters.date_to,
			change: () => {
				this.filters.date_to = this.page.fields_dict.date_to.get_value();
				this._load_queue();
			},
		});
		this.page.add_field({
			fieldname: "warehouse", label: __("Store"), fieldtype: "Link", options: "Warehouse",
			change: () => {
				this.filters.warehouse = this.page.fields_dict.warehouse.get_value() || null;
				this._load_queue();
			},
		});
		this.page.add_field({
			fieldname: "stage_filter", label: __("Show"), fieldtype: "Select",
			options: "active\nall", default: "active",
			change: () => {
				this.filters.stage_filter = this.page.fields_dict.stage_filter.get_value();
				this._load_queue();
			},
		});
		this.page.add_button(__("Refresh"), () => this._refresh_all(), { icon: "refresh" });
	}

	// ── Layout ─────────────────────────────────────────────────────────────────

	_build_layout() {
		this.parent.html(`
			<div class="goh-root">
				<div class="goh-sidebar" id="goh-sidebar">
					<div class="goh-sidebar-search">
						<input type="text" id="goh-search" class="form-control input-sm"
							placeholder="${__("Search ticket, customer, device…")}">
					</div>
					<div class="goh-queue-list" id="goh-queue-list">
						<div class="goh-loading"><i class="fa fa-spinner fa-spin"></i> ${__("Loading…")}</div>
					</div>
				</div>
				<div class="goh-main" id="goh-main">
					<div class="goh-placeholder">
						<i class="fa fa-inbox fa-3x text-muted"></i>
						<p class="text-muted mt-2">${__("Select a ticket from the queue to begin")}</p>
					</div>
				</div>
			</div>
		`);

		let _st;
		this.parent.find("#goh-search").on("input", e => {
			clearTimeout(_st);
			_st = setTimeout(() => {
				this.filters.search = e.target.value.trim();
				this._render_queue();
			}, 300);
		});

		this.parent.on("click", ".goh-queue-item", e => {
			const name = $(e.currentTarget).data("name");
			if (name) this._select_ticket(name);
		});
	}

	// ── Queue ──────────────────────────────────────────────────────────────────

	_load_queue() {
		this.parent.find("#goh-queue-list").html(
			`<div class="goh-loading"><i class="fa fa-spinner fa-spin"></i></div>`
		);
		frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.get_ticket_queue", {
			warehouse:    this.filters.warehouse || "",
			search:       "",
			date_from:    this.filters.date_from,
			date_to:      this.filters.date_to,
			stage_filter: this.filters.stage_filter,
		}).then(data => {
			this.queue = data || [];
			this._render_queue();
		}).catch(() => {
			this.parent.find("#goh-queue-list").html(
				`<p class="text-danger p-2"><i class="fa fa-exclamation-circle"></i> ${__("Failed to load queue")}</p>`
			);
		});
	}

	_render_queue() {
		const search = this.filters.search.toLowerCase();
		const items = this.queue.filter(sr => {
			if (!search) return true;
			return (
				(sr.name + " " + (sr.customer_name || "") + " " +
				 (sr.device_item_name || "") + " " + (sr.serial_no || "") +
				 " " + (sr.contact_number || ""))
				.toLowerCase()
				.includes(search)
			);
		});

		if (!items.length) {
			this.parent.find("#goh-queue-list").html(
				`<p class="text-muted text-center p-3"><i class="fa fa-inbox"></i><br>${__("No tickets found")}</p>`
			);
			return;
		}

		const html = items.map(sr => this._queue_item_html(sr)).join("");
		this.parent.find("#goh-queue-list").html(html);

		// Re-highlight selected
		if (this.selected) {
			this.parent.find(`.goh-queue-item[data-name="${CSS.escape(this.selected)}"]`).addClass("goh-queue-item-active");
		}
	}

	_queue_item_html(sr) {
		const esc = frappe.utils.escape_html;
		const sb = STAGE_BADGE[sr.ops_stage] || { label: sr.ops_stage, cls: "goh-badge-muted" };
		const pc = PRIORITY_COLORS[sr.priority] || "#6b7280";
		const today = frappe.datetime.nowdate();
		const daysOpen = frappe.datetime.get_day_diff(today, sr.service_date);
		const overdue = sr.expected_completion_date && sr.expected_completion_date < today;

		return `
			<div class="goh-queue-item${overdue ? " goh-queue-overdue" : ""}" data-name="${esc(sr.name)}">
				<div class="goh-qi-header">
					<span class="goh-qi-name">${esc(sr.name)}</span>
					<span class="goh-badge ${sb.cls}">${__(sb.label)}</span>
				</div>
				<div class="goh-qi-customer">
					<i class="fa fa-user text-muted"></i>
					<b>${esc(sr.customer_name || sr.customer)}</b>
				</div>
				<div class="goh-qi-device">
					<i class="fa fa-mobile text-muted"></i>
					${esc(sr.device_item_name || sr.device_item || "—")}
					${sr.serial_no ? `<code class="goh-qi-serial">${esc(sr.serial_no)}</code>` : ""}
				</div>
				<div class="goh-qi-footer">
					<span class="goh-qi-age${daysOpen > 7 ? " goh-age-warn" : ""}">${daysOpen}d</span>
					<span class="goh-qi-priority" style="color:${pc};">${esc(sr.priority)}</span>
				</div>
			</div>
		`;
	}

	// ── Ticket Selection ───────────────────────────────────────────────────────

	_select_ticket(sr_name) {
		this.selected = sr_name;
		this.parent.find(".goh-queue-item").removeClass("goh-queue-item-active");
		this.parent.find(`.goh-queue-item[data-name="${CSS.escape(sr_name)}"]`).addClass("goh-queue-item-active");
		this._load_detail(sr_name);
	}

	_load_detail(sr_name) {
		this.parent.find("#goh-main").html(
			`<div class="goh-loading goh-main-loading"><i class="fa fa-spinner fa-spin fa-2x"></i></div>`
		);
		frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.get_ticket_detail", { sr_name })
			.then(d => {
				this.detail = d;
				this._render_detail(d);
			})
			.catch(() => {
				this.parent.find("#goh-main").html(
					`<p class="text-danger p-3"><i class="fa fa-exclamation-circle"></i> ${__("Failed to load ticket details")}</p>`
				);
			});
	}

	_refresh_all() {
		this._load_queue();
		if (this.selected) this._load_detail(this.selected);
	}

	// ── Detail Panel ───────────────────────────────────────────────────────────

	_render_detail(d) {
		const esc = frappe.utils.escape_html;

		// Step stepper header
		const stepperHtml = this._stepper_html(d.ops_stage);

		// SR info banner
		const bannerHtml = this._banner_html(d);

		// Step content
		let contentHtml = "";
		if (d.ops_stage === "analysis")  contentHtml = this._html_analysis(d);
		else if (d.ops_stage === "confirm")   contentHtml = this._html_confirm(d);
		else if (d.ops_stage === "solutions") contentHtml = this._html_solutions(d);
		else if (d.ops_stage === "assign")    contentHtml = this._html_assign(d);
		else if (d.ops_stage === "repair")    contentHtml = this._html_repair(d);
		else if (d.ops_stage === "qc")        contentHtml = this._html_qc(d);
		else if (d.ops_stage === "invoice")   contentHtml = this._html_invoice(d);
		else if (d.ops_stage === "rework")    contentHtml = this._html_rework(d);
		else if (d.ops_stage === "done")      contentHtml = this._html_done(d);
		else contentHtml = `<p class="text-muted p-3">${__("Ticket is {0}. No action needed.", [d.decision])}</p>`;

		this.parent.find("#goh-main").html(`
			<div class="goh-detail">
				<div class="goh-detail-header">
					<div class="goh-detail-title">
						<a href="/desk/service-request/${encodeURIComponent(d.name)}" target="_blank"
						   class="goh-sr-link">${esc(d.name)}</a>
						<span class="goh-badge goh-badge-muted ml-1">${esc(d.decision)}</span>
					</div>
					${stepperHtml}
				</div>
				${bannerHtml}
				<div class="goh-step-content" id="goh-step-content">
					${contentHtml}
				</div>
			</div>
		`);

		this._bind_step_events(d);
	}

	_stepper_html(active_stage) {
		return `
			<div class="goh-stepper">
				${STAGES.map((s, i) => {
					const idx = STAGE_ORDER.indexOf(active_stage);
					const stepIdx = i;
					let cls = "goh-step";
					if (s.key === active_stage) cls += " goh-step-active";
					else if (stepIdx < idx)     cls += " goh-step-done";
					return `
						<div class="${cls}">
							<span class="goh-step-num">${s.key === active_stage ? `<i class="fa ${s.icon}"></i>` : (stepIdx < idx ? "✓" : stepIdx + 1)}</span>
							<span class="goh-step-label">${__(s.label)}</span>
						</div>
						${i < STAGES.length - 1 ? '<div class="goh-step-connector"></div>' : ""}
					`;
				}).join("")}
			</div>
		`;
	}

	_banner_html(d) {
		const esc = frappe.utils.escape_html;
		const pc = PRIORITY_COLORS[d.priority] || "#6b7280";

		return `
			<div class="goh-banner">
				<div class="goh-banner-row">
					<div class="goh-banner-col">
						<span class="goh-banner-label">${__("Customer")}</span>
						<span class="goh-banner-val"><b>${esc(d.customer_name || d.customer)}</b></span>
						${d.contact_number ? `<span class="goh-banner-sub"><i class="fa fa-phone"></i> ${esc(d.contact_number)}</span>` : ""}
					</div>
					<div class="goh-banner-col">
						<span class="goh-banner-label">${__("Device")}</span>
						<span class="goh-banner-val"><b>${esc(d.device_item_name || d.device_item)}</b></span>
						${d.serial_no ? `<span class="goh-banner-sub"><i class="fa fa-barcode"></i> <code>${esc(d.serial_no)}</code></span>` : ""}
					</div>
					<div class="goh-banner-col">
						<span class="goh-banner-label">${__("Priority")}</span>
						<span class="goh-banner-val" style="color:${pc};font-weight:600;">${esc(d.priority)}</span>
						${d.warranty_status ? `<span class="goh-banner-sub">${esc(d.warranty_status)}</span>` : ""}
					</div>
					<div class="goh-banner-col">
						<span class="goh-banner-label">${__("Store")}</span>
						<span class="goh-banner-val">${esc(d.source_warehouse || "—")}</span>
						${d.service_date ? `<span class="goh-banner-sub"><i class="fa fa-calendar"></i> ${frappe.datetime.str_to_user(d.service_date)}</span>` : ""}
					</div>
				</div>
			</div>
		`;
	}

	// ── Step 1: Analysis ───────────────────────────────────────────────────────

	_html_analysis(d) {
		const esc = frappe.utils.escape_html;

		// Original reported issue from SR
		const originalIssue = d.issue_category
			? `<div class="goh-info-box mb-3">
				<i class="fa fa-exclamation-circle text-muted"></i>
				<b>${__("Customer Reported")}:</b> ${esc(d.issue_category)}
				${d.issue_description ? ` — <span class="text-muted">${esc(d.issue_description.replace(/<[^>]+>/g, "").substring(0, 120))}</span>` : ""}
			   </div>`
			: "";

		const rowsHtml = (d.issue_lines || []).map((iss, idx) => `
			<tr data-idx="${idx}">
				<td>
					<input class="form-control input-xs goh-issue-cat" data-idx="${idx}"
					       value="${esc(iss.issue_category || "")}"
					       placeholder="${__("Issue Category")}" list="goh-cat-list">
				</td>
				<td>
					<select class="form-control input-xs goh-issue-reporter" data-idx="${idx}">
						<option value="Customer"${iss.reported_by === "Customer" ? " selected" : ""}>${__("Customer")}</option>
						<option value="Technician"${iss.reported_by !== "Customer" ? " selected" : ""}>${__("Technician")}</option>
					</select>
				</td>
				<td>
					<input class="form-control input-xs goh-issue-desc" data-idx="${idx}"
					       value="${esc(iss.description || "")}"
					       placeholder="${__("Description (optional)")}">
				</td>
				<td class="text-center">
					<button class="btn btn-xs btn-danger goh-issue-remove" data-idx="${idx}">
						<i class="fa fa-trash"></i>
					</button>
				</td>
			</tr>
		`).join("");

		return `
			${originalIssue}
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-search"></i> ${__("Identify Issues")}
					<button class="btn btn-xs btn-default ml-2" id="goh-add-issue">
						<i class="fa fa-plus"></i> ${__("Add Issue")}
					</button>
				</div>

				<datalist id="goh-cat-list" id="goh-cat-datalist"></datalist>

				<div class="table-responsive">
					<table class="goh-table goh-issue-table" id="goh-issue-table">
						<thead>
							<tr>
								<th>${__("Issue Category")}</th>
								<th>${__("Reported By")}</th>
								<th>${__("Description")}</th>
								<th></th>
							</tr>
						</thead>
						<tbody id="goh-issue-tbody">
							${rowsHtml || `<tr><td colspan="4" class="text-muted text-center">${__("No issues yet. Click Add Issue to begin.")}</td></tr>`}
						</tbody>
					</table>
				</div>
			</div>

			<div class="goh-step-actions">
				<button class="btn btn-primary btn-sm" id="goh-save-issues">
					<i class="fa fa-save"></i> ${__("Save Issues")}
				</button>
				<button class="btn btn-success btn-sm ml-2" id="goh-confirm-analysis">
					<i class="fa fa-check"></i> ${__("Confirm Analysis & Proceed")}
				</button>
			</div>
		`;
	}

	// ── Step 2: Customer Confirmation ──────────────────────────────────────────

	_html_confirm(d) {
		const esc = frappe.utils.escape_html;

		const issueList = (d.issue_lines || [])
			.filter(i => i.status !== "Cancelled")
			.map(i => `<li><b>${esc(i.issue_category)}</b>${i.description ? " — " + esc(i.description) : ""} <span class="badge">${esc(i.reported_by)}</span></li>`)
			.join("");

		const waStatus = d.confirmation_sent_at
			? `<span class="goh-badge goh-badge-yellow"><i class="fa fa-whatsapp"></i> ${__("Sent on")} ${frappe.datetime.str_to_user(d.confirmation_sent_at)}</span>`
			: `<span class="goh-badge goh-badge-muted">${__("Not sent yet")}</span>`;

		return `
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-list-alt"></i> ${__("Issues for Customer Approval")}
				</div>
				<ul class="goh-issue-summary-list">${issueList || `<li class="text-muted">${__("No issues confirmed")}</li>`}</ul>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-money"></i> ${__("Estimated Cost")}
				</div>
				<div class="goh-cost-display">
					<span class="goh-cost-amount">₹ ${frappe.utils.fmt_money(d.estimated_cost || d.total_estimated_cost || 0)}</span>
					<span class="text-muted small ml-2">${__("(update on Service Request form if needed)")}</span>
				</div>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-whatsapp"></i> ${__("WhatsApp Confirmation")}
				</div>
				<div class="mb-2">${waStatus}</div>
				<button class="btn btn-default btn-sm" id="goh-send-wa">
					<i class="fa fa-whatsapp"></i> ${d.confirmation_sent_at ? __("Resend WhatsApp") : __("Send WhatsApp for Confirmation")}
				</button>
			</div>

			<div class="goh-step-actions">
				<button class="btn btn-primary btn-sm" id="goh-mark-confirmed">
					<i class="fa fa-check-circle"></i> ${__("Mark Customer Confirmed & Proceed")}
				</button>
				<button class="btn btn-default btn-sm ml-2" id="goh-back-to-analysis">
					<i class="fa fa-arrow-left"></i> ${__("Back to Analysis")}
				</button>
			</div>
		`;
	}

	// ── Step 3: Solution Assignment ────────────────────────────────────────────

	_html_solutions(d) {
		const esc = frappe.utils.escape_html;

		const uniqueCategories = [...new Set(
			(d.issue_lines || [])
				.filter(i => i.status !== "Cancelled" && i.issue_category)
				.map(i => i.issue_category)
		)];

		const catCards = uniqueCategories.map(cat => `
			<div class="goh-sol-category-card" data-category="${esc(cat)}">
				<div class="goh-sol-cat-header">
					<i class="fa fa-tag"></i> ${esc(cat)}
				</div>
				<div class="goh-sol-list" id="goh-sol-list-${esc(cat.replace(/[^a-zA-Z0-9]/g, "_"))}">
					<div class="goh-loading-inline"><i class="fa fa-spinner fa-spin"></i> ${__("Loading solutions…")}</div>
				</div>
			</div>
		`).join("");

		return `
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-bolt"></i> ${__("Select Repair Solutions")}
					<span class="text-muted small ml-2">${__("Choose the applicable solutions for each issue")}</span>
				</div>
				<div id="goh-solution-cards">
					${catCards || `<p class="text-muted">${__("No confirmed issues to assign solutions for.")}</p>`}
				</div>
			</div>

			<div class="goh-step-actions">
				<button class="btn btn-primary btn-sm" id="goh-save-solutions">
					<i class="fa fa-save"></i> ${__("Assign Solutions & Proceed")}
				</button>
			</div>
		`;
	}

	_load_solutions_for_categories(d) {
		const categories = [...new Set(
			(d.issue_lines || [])
				.filter(i => i.status !== "Cancelled" && i.issue_category)
				.map(i => i.issue_category)
		)];

		categories.forEach(cat => {
			const safeId = cat.replace(/[^a-zA-Z0-9]/g, "_");
			frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.get_solutions_for_issue", {
				issue_category: cat,
			}).then(solutions => {
				const esc = frappe.utils.escape_html;
				if (!solutions || !solutions.length) {
					this.parent.find(`#goh-sol-list-${safeId}`).html(
						`<p class="text-muted small">${__("No solutions configured for this category.")}</p>`
					);
					return;
				}

				const html = solutions.map(sol => `
					<label class="goh-sol-option">
						<input type="checkbox" class="goh-sol-check"
						       data-solution="${esc(sol.name)}"
						       data-category="${esc(cat)}"
						       data-code="${esc(sol.solution_code || "")}"
						       data-minutes="${sol.estimated_minutes || 0}"
						       data-requires-spare="${sol.requires_spare ? 1 : 0}"
						       data-auto-spares="1">
						<span class="goh-sol-name">${esc(sol.solution_name)}</span>
						<span class="goh-badge goh-badge-muted ml-1">${esc(sol.grade_display)}</span>
						${sol.estimated_minutes ? `<span class="text-muted small ml-1">${sol.estimated_minutes}min</span>` : ""}
						${sol.requires_spare ? `<span class="goh-badge goh-badge-yellow ml-1"><i class="fa fa-cogs"></i> ${__("Spare")}</span>` : ""}
						${sol.description ? `<span class="goh-sol-desc text-muted">${esc(sol.description)}</span>` : ""}
					</label>
				`).join("");

				this.parent.find(`#goh-sol-list-${safeId}`).html(html);
			});
		});
	}

	// ── Step 4: Technician Assignment ──────────────────────────────────────────

	_html_assign(d) {
		const esc = frappe.utils.escape_html;

		const solRows = (d.solution_lines || []).map(sol => `
			<tr>
				<td>${esc(sol.repair_solution || "")}</td>
				<td>${esc(sol.issue_category || "")}</td>
				<td><span class="goh-badge goh-badge-muted">${esc(sol.status)}</span></td>
			</tr>
		`).join("");

		return `
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-bolt"></i> ${__("Solutions to Assign")}
				</div>
				<div class="table-responsive">
					<table class="goh-table">
						<thead><tr><th>${__("Solution")}</th><th>${__("Issue")}</th><th>${__("Status")}</th></tr></thead>
						<tbody>${solRows || `<tr><td colspan="3" class="text-muted">${__("No solutions")}</td></tr>`}</tbody>
					</table>
				</div>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-user-plus"></i> ${__("Assign Technician")}
				</div>
				<div class="goh-assign-form">
					<div class="goh-form-row">
						<label>${__("Technician")}</label>
						<div id="goh-tech-field-wrapper"></div>
					</div>
					<div class="goh-form-row">
						<label>${__("Job Type")}</label>
						<select class="form-control input-sm" id="goh-job-type">
							<option value="Repair">${__("Repair")}</option>
							<option value="Diagnosis">${__("Diagnosis")}</option>
							<option value="Spare Parts Replacement">${__("Spare Parts Replacement")}</option>
							<option value="Software Update">${__("Software Update")}</option>
							<option value="Testing">${__("Testing")}</option>
						</select>
					</div>
					<div class="goh-form-row">
						<label>${__("Est. Hours")}</label>
						<input type="number" class="form-control input-sm" id="goh-est-hours"
						       min="0.5" step="0.5" value="2" style="width:100px;">
					</div>
				</div>
			</div>

			<div class="goh-step-actions">
				<button class="btn btn-primary btn-sm" id="goh-do-assign">
					<i class="fa fa-user-plus"></i> ${__("Assign & Start Repair")}
				</button>
			</div>
		`;
	}

	_init_technician_field() {
		// Use Frappe's Link field control for technician picker
		const wrapper = this.parent.find("#goh-tech-field-wrapper");
		if (!wrapper.length) return;

		this._tech_field = frappe.ui.form.make_control({
			parent: wrapper[0],
			df: {
				fieldname: "technician",
				label: __("Technician"),
				fieldtype: "Link",
				options: "Employee",
				reqd: 1,
			},
			render_input: true,
		});
		this._tech_field.refresh();
	}

	// ── Step 5: Repair Execution ────────────────────────────────────────────────

	_html_repair(d) {
		const esc = frappe.utils.escape_html;

		// Check if all solutions are done/skipped
		const sols = d.solution_lines || [];
		const allDone = sols.length > 0 && sols.every(s => s.status === "Completed" || s.status === "Skipped");

		const STATUS_COL = {
			Planned: "goh-badge-muted",
			"In Progress": "goh-badge-blue",
			Completed: "goh-badge-green",
			Skipped: "goh-badge-yellow",
		};

		const solutionRows = (d.solution_lines || []).map(sol => `
			<div class="goh-repair-card" data-row="${esc(sol.name)}">
				<div class="goh-repair-card-head">
					<span class="goh-repair-sol-name">${esc(sol.repair_solution || "—")}</span>
					<span class="goh-badge ${STATUS_COL[sol.status] || "goh-badge-muted"}">${esc(sol.status)}</span>
				</div>
				<div class="goh-repair-card-meta text-muted small">
					<i class="fa fa-tag"></i> ${esc(sol.issue_category || "")}
					${sol.estimated_minutes ? `<span class="ml-2"><i class="fa fa-clock-o"></i> ${sol.estimated_minutes}min</span>` : ""}
				</div>
				${sol.technician_remarks ? `<div class="goh-repair-remarks text-muted small">${esc(sol.technician_remarks)}</div>` : ""}
				<div class="goh-repair-card-actions">
					${sol.status !== "In Progress" && sol.status !== "Completed" ? `
						<button class="btn btn-xs btn-default goh-sol-inprogress" data-row="${esc(sol.name)}">
							<i class="fa fa-play"></i> ${__("Start")}
						</button>` : ""}
					${sol.status === "In Progress" ? `
						<button class="btn btn-xs btn-success goh-sol-complete" data-row="${esc(sol.name)}">
							<i class="fa fa-check"></i> ${__("Mark Done")}
						</button>` : ""}
					${sol.status !== "Completed" && sol.status !== "Skipped" ? `
						<button class="btn btn-xs btn-warning goh-sol-skip" data-row="${esc(sol.name)}">
							${__("Skip")}
						</button>` : ""}
				</div>
			</div>
		`).join("");

		// Spare parts
		const spareRows = (d.spare_lines || []).map(sp => `
			<tr>
				<td>${esc(sp.item_name || sp.spare_item)}</td>
				<td>${sp.qty} ${esc(sp.uom)}</td>
				<td>₹${frappe.utils.fmt_money(sp.rate)}</td>
				<td><span class="goh-badge goh-badge-muted">${esc(sp.status)}</span></td>
			</tr>
		`).join("");

		// Assignments
		const assignRows = (d.assignments || []).map(a => `
			<div class="goh-assign-chip">
				<i class="fa fa-user"></i>
				<b>${frappe.utils.escape_html(a.engineer_display)}</b>
				<span class="goh-badge goh-badge-muted ml-1">${frappe.utils.escape_html(a.job_type)}</span>
				<span class="goh-badge ${a.assignment_status === "Completed" ? "goh-badge-green" : "goh-badge-blue"} ml-1">
					${frappe.utils.escape_html(a.assignment_status)}
				</span>
			</div>
		`).join("");

		return `
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-users"></i> ${__("Assigned Technicians")}
				</div>
				<div class="goh-assign-chips">${assignRows || `<span class="text-muted">${__("None")}</span>`}</div>
				<button class="btn btn-xs btn-default mt-2" id="goh-handoff-btn">
					<i class="fa fa-exchange"></i> ${__("Hand Off to Another Technician")}
				</button>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-wrench"></i> ${__("Repair Progress")}
					<span class="text-muted small ml-2">${(d.solution_lines || []).filter(s => s.status === "Completed").length} / ${(d.solution_lines || []).length} ${__("done")}</span>
				</div>
				<div id="goh-repair-cards">
					${solutionRows || `<p class="text-muted">${__("No solutions assigned. Go back to Solutions step.")}</p>`}
				</div>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-cogs"></i> ${__("Spare Parts Used")}
					<button class="btn btn-xs btn-default ml-2" id="goh-add-spare-btn">
						<i class="fa fa-plus"></i> ${__("Add Spare")}
					</button>
				</div>
				<div class="table-responsive">
					<table class="goh-table" id="goh-spare-table">
						<thead><tr><th>${__("Part")}</th><th>${__("Qty")}</th><th>${__("Rate")}</th><th>${__("Status")}</th></tr></thead>
						<tbody>${spareRows || `<tr><td colspan="4" class="text-muted text-center">${__("No spares yet")}</td></tr>`}</tbody>
					</table>
				</div>
			</div>

			<div class="goh-step-actions">
				${allDone ? `
					<button class="btn btn-sm btn-primary" id="goh-submit-qc">
						<i class="fa fa-check-square-o"></i> ${__("All Fixed — Submit for QC")}
					</button>` : ""}
				<a href="/desk/service-request/${encodeURIComponent(d.name)}" target="_blank"
				   class="btn btn-default btn-sm${allDone ? " ml-2" : ""}">
					<i class="fa fa-external-link"></i> ${__("Open Service Request")}
				</a>
				${d.service_order ? `
					<a href="/desk/sales-order/${encodeURIComponent(d.service_order)}" target="_blank"
					   class="btn btn-default btn-sm ml-2">
						<i class="fa fa-file-text-o"></i> ${__("Open Service Order")}
					</a>` : ""}
			</div>
		`;
	}

	// ── QC ─────────────────────────────────────────────────────────────────────

	_html_qc(d) {
		const esc = frappe.utils.escape_html;
		const qc_status = d.qc_status || "Awaiting";

		// QC checklist rows
		const checklist = d.qc_checklist || [];
		const checkRows = checklist.map(row => `
			<tr class="goh-qc-row" data-name="${esc(row.name)}">
				<td>${esc(row.check_name)}</td>
				<td>
					<select class="form-control input-xs goh-qc-result" data-name="${esc(row.name)}" data-check="${esc(row.check_name)}">
						<option value="">${__("-- Select --")}</option>
						<option value="Pass" ${row.result === "Pass" ? "selected" : ""}>${__("Pass")}</option>
						<option value="Fail" ${row.result === "Fail" ? "selected" : ""}>${__("Fail")}</option>
						<option value="N/A" ${row.result === "N/A" ? "selected" : ""}>${__("N/A")}</option>
					</select>
				</td>
				<td><input class="form-control input-xs goh-qc-remarks" data-name="${esc(row.name)}" data-check="${esc(row.check_name)}" value="${esc(row.remarks || "")}" placeholder="${__("Remarks")}"></td>
			</tr>
		`).join("");

		// Solution summary
		const solSummary = (d.solution_lines || []).map(sol => `
			<div class="goh-qc-sol-chip">
				<span class="goh-badge ${sol.status === "Completed" ? "goh-badge-green" : "goh-badge-yellow"}">${esc(sol.status)}</span>
				${esc(sol.repair_solution || "—")}
				<span class="text-muted small ml-1">(${esc(sol.issue_category || "")})</span>
			</div>
		`).join("");

		const qcCheckedBy = d.qc_checked_by ? `<span class="text-muted small ml-2">${__("By")}: ${esc(frappe.user.full_name(d.qc_checked_by))}</span>` : "";

		return `
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-wrench"></i> ${__("Solutions Completed")}
				</div>
				<div class="goh-qc-sol-list">${solSummary || `<span class="text-muted">${__("No solutions")}</span>`}</div>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-check-square-o"></i> ${__("QC Checklist")}
					<span class="goh-badge ${qc_status === "Pass" ? "goh-badge-green" : qc_status === "Fail" ? "goh-badge-red" : "goh-badge-purple"} ml-2">${esc(qc_status)}</span>
					${qcCheckedBy}
				</div>
				${checklist.length ? `
					<div class="table-responsive">
						<table class="goh-table" id="goh-qc-table">
							<thead><tr><th>${__("Check")}</th><th style="width:120px;">${__("Result")}</th><th>${__("Remarks")}</th></tr></thead>
							<tbody>${checkRows}</tbody>
						</table>
					</div>
					<div class="mt-2">
						<button class="btn btn-xs btn-default" id="goh-save-qc">
							<i class="fa fa-save"></i> ${__("Save QC Results")}
						</button>
					</div>
				` : `<p class="text-muted">${__("No QC checklist found on Service Order. Submit for QC first.")}</p>`}
			</div>

			<div class="goh-step-actions">
				<button class="btn btn-sm btn-success" id="goh-qc-pass">
					<i class="fa fa-check-circle"></i> ${__("QC Pass")}
				</button>
				<button class="btn btn-sm btn-danger ml-2" id="goh-qc-fail">
					<i class="fa fa-times-circle"></i> ${__("QC Fail")}
				</button>
				<a href="/desk/service-request/${encodeURIComponent(d.name)}" target="_blank"
				   class="btn btn-default btn-sm ml-2">
					<i class="fa fa-external-link"></i> ${__("Open SR")}
				</a>
				${d.service_order ? `
					<a href="/desk/sales-order/${encodeURIComponent(d.service_order)}" target="_blank"
					   class="btn btn-default btn-sm ml-2">
						<i class="fa fa-file-text-o"></i> ${__("Open Service Order")}
					</a>` : ""}
			</div>
		`;
	}

	// ── Invoice ────────────────────────────────────────────────────────────────

	_html_invoice(d) {
		const esc = frappe.utils.escape_html;

		// We'll load the billing summary via API on bind — show placeholder
		return `
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-check-circle" style="color:#10b981;"></i> ${__("QC Passed")}
				</div>
				<p class="text-muted">${__("Quality check has been passed. Ready for invoicing.")}</p>
			</div>

			<div class="goh-step-section" id="goh-invoice-summary">
				<div class="goh-step-section-title">
					<i class="fa fa-file-text-o"></i> ${__("Billing Summary")}
				</div>
				<div class="text-center p-3">
					<i class="fa fa-spinner fa-spin"></i> ${__("Loading...")}
				</div>
			</div>

			<div class="goh-step-actions">
				<a href="/desk/service-request/${encodeURIComponent(d.name)}" target="_blank"
				   class="btn btn-default btn-sm">
					<i class="fa fa-external-link"></i> ${__("Open SR")}
				</a>
				${d.service_invoice ? `
					<a href="/desk/sales-invoice/${encodeURIComponent(d.service_invoice)}" target="_blank"
					   class="btn btn-primary btn-sm ml-2">
						<i class="fa fa-file-text-o"></i> ${__("Open Invoice")}
					</a>` : ""}
				${d.service_order ? `
					<a href="/desk/sales-order/${encodeURIComponent(d.service_order)}" target="_blank"
					   class="btn btn-default btn-sm ml-2">
						<i class="fa fa-file-text-o"></i> ${__("Open Service Order")}
					</a>` : ""}
			</div>
		`;
	}

	// ── Rework (QC Fail) ───────────────────────────────────────────────────────

	_html_rework(d) {
		const esc = frappe.utils.escape_html;

		// Failed QC checklist items
		const failedChecks = (d.qc_checklist || []).filter(c => c.result === "Fail");
		const failRows = failedChecks.map(row => `
			<tr>
				<td><i class="fa fa-times-circle text-danger"></i> ${esc(row.check_name)}</td>
				<td>${esc(row.remarks || "—")}</td>
			</tr>
		`).join("");

		// All checklist items for reference
		const allRows = (d.qc_checklist || []).map(row => `
			<tr>
				<td>${esc(row.check_name)}</td>
				<td><span class="goh-badge ${row.result === "Pass" ? "goh-badge-green" : row.result === "Fail" ? "goh-badge-red" : "goh-badge-muted"}">${esc(row.result || "—")}</span></td>
				<td class="text-muted small">${esc(row.remarks || "")}</td>
			</tr>
		`).join("");

		// Current assignments
		const assignRows = (d.assignments || []).map(a => `
			<div class="goh-assign-chip">
				<i class="fa fa-user"></i>
				<b>${esc(a.engineer_display)}</b>
				<span class="goh-badge goh-badge-muted ml-1">${esc(a.job_type)}</span>
			</div>
		`).join("");

		return `
			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-exclamation-triangle text-danger"></i> ${__("QC Failed")}
					${d.qc_checked_by ? `<span class="text-muted small ml-2">${__("By")}: ${esc(frappe.user.full_name(d.qc_checked_by))}</span>` : ""}
				</div>
				<p class="text-muted">${__("The following checks failed. Floor manager must review and reassign to a technician.")}</p>

				${failRows ? `
					<div class="goh-rework-fail-table">
						<table class="goh-table">
							<thead><tr><th>${__("Failed Check")}</th><th>${__("Remarks")}</th></tr></thead>
							<tbody>${failRows}</tbody>
						</table>
					</div>
				` : ""}
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-list"></i> ${__("Full QC Checklist")}
				</div>
				<div class="table-responsive">
					<table class="goh-table">
						<thead><tr><th>${__("Check")}</th><th>${__("Result")}</th><th>${__("Remarks")}</th></tr></thead>
						<tbody>${allRows || `<tr><td colspan="3" class="text-muted text-center">${__("No checklist")}</td></tr>`}</tbody>
					</table>
				</div>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-users"></i> ${__("Previous Assignments")}
				</div>
				<div class="goh-assign-chips">${assignRows || `<span class="text-muted">${__("None")}</span>`}</div>
			</div>

			<div class="goh-step-section">
				<div class="goh-step-section-title">
					<i class="fa fa-user-plus"></i> ${__("Reassign to Technician")}
				</div>
				<div class="row">
					<div class="col-sm-5">
						<div id="goh-rework-tech-field"></div>
					</div>
					<div class="col-sm-3">
						<select class="form-control input-sm" id="goh-rework-job-type">
							<option value="Repair">${__("Repair")}</option>
							<option value="Diagnosis">${__("Diagnosis")}</option>
							<option value="Spare Parts Replacement">${__("Spare Parts Replacement")}</option>
							<option value="Testing">${__("Testing")}</option>
						</select>
					</div>
					<div class="col-sm-4">
						<textarea class="form-control input-sm" id="goh-rework-notes" rows="2"
							placeholder="${__("Manager notes / instructions")}"></textarea>
					</div>
				</div>
				<div class="mt-2">
					<button class="btn btn-sm btn-primary" id="goh-rework-assign">
						<i class="fa fa-user-plus"></i> ${__("Reassign & Send Back to Repair")}
					</button>
				</div>
			</div>
		`;
	}

	// ── Done ───────────────────────────────────────────────────────────────────

	_html_done(d) {
		const esc = frappe.utils.escape_html;
		return `
			<div class="goh-done-banner">
				<i class="fa fa-check-circle fa-3x" style="color:#10b981;"></i>
				<h4 class="mt-2">${__("Repair Complete")}</h4>
				<p class="text-muted">${__("Status")}: <b>${esc(d.decision)}</b></p>
				<a href="/desk/service-request/${encodeURIComponent(d.name)}" target="_blank"
				   class="btn btn-default btn-sm mt-2">
					<i class="fa fa-external-link"></i> ${__("View Service Request")}
				</a>
			</div>
		`;
	}

	// ── Event Binding ──────────────────────────────────────────────────────────

	_bind_step_events(d) {
		const content = this.parent.find("#goh-step-content");
		const self = this;

		// ── Analysis events ──
		if (d.ops_stage === "analysis") {
			// Load categories into datalist
			frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.get_issue_categories")
				.then(cats => {
					const opts = (cats || []).map(c => `<option value="${frappe.utils.escape_html(c)}">`).join("");
					this.parent.find("#goh-cat-list").html(opts);
				});

			// Add issue row
			content.find("#goh-add-issue").on("click", () => {
				const tbody = this.parent.find("#goh-issue-tbody");
				const idx = tbody.find("tr").length;
				// Remove "no issues" row if present
				tbody.find("td[colspan]").closest("tr").remove();
				const esc = frappe.utils.escape_html;
				tbody.append(`
					<tr data-idx="${idx}">
						<td><input class="form-control input-xs goh-issue-cat" data-idx="${idx}" placeholder="${__("Issue Category")}" list="goh-cat-list"></td>
						<td>
							<select class="form-control input-xs goh-issue-reporter" data-idx="${idx}">
								<option value="Technician">${__("Technician")}</option>
								<option value="Customer">${__("Customer")}</option>
							</select>
						</td>
						<td><input class="form-control input-xs goh-issue-desc" data-idx="${idx}" placeholder="${__("Description")}"></td>
						<td class="text-center"><button class="btn btn-xs btn-danger goh-issue-remove" data-idx="${idx}"><i class="fa fa-trash"></i></button></td>
					</tr>
				`);
			});

			// Remove issue row
			content.on("click", ".goh-issue-remove", function () {
				$(this).closest("tr").remove();
			});

			// Save issues
			content.find("#goh-save-issues").on("click", () => {
				const issues = self._collect_issues();
				if (!issues.length) {
					frappe.show_alert({ message: __("Add at least one issue."), indicator: "orange" });
					return;
				}
				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.save_issue_lines", {
					sr_name: d.name,
					issues_json: JSON.stringify(issues),
				}).then(() => {
					frappe.show_alert({ message: __("Issues saved."), indicator: "green" });
					self._load_detail(d.name);
				});
			});

			// Confirm analysis
			content.find("#goh-confirm-analysis").on("click", () => {
				const issues = self._collect_issues();
				if (!issues.length) {
					frappe.show_alert({ message: __("Add at least one issue before confirming."), indicator: "orange" });
					return;
				}
				// Save then confirm
				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.save_issue_lines", {
					sr_name: d.name,
					issues_json: JSON.stringify(issues),
				}).then(() => {
					return frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.confirm_analysis", {
						sr_name: d.name,
					});
				}).then(() => {
					frappe.show_alert({ message: __("Analysis confirmed. Proceed to customer confirmation."), indicator: "green" });
					self._refresh_all();
				});
			});
		}

		// ── Confirm events ──
		if (d.ops_stage === "confirm") {
			content.find("#goh-send-wa").on("click", () => {
				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.send_confirmation_whatsapp", {
					sr_name: d.name,
				}).then(res => {
					const msg = res.whatsapp_sent
						? __("WhatsApp sent to customer.")
						: __("WhatsApp not configured — mark confirmed manually.");
					frappe.show_alert({ message: msg, indicator: res.whatsapp_sent ? "green" : "orange" });
					self._load_detail(d.name);
				});
			});

			content.find("#goh-mark-confirmed").on("click", () => {
				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.mark_customer_confirmed", {
					sr_name: d.name,
				}).then(() => {
					frappe.show_alert({ message: __("Customer confirmed. Assign solutions."), indicator: "green" });
					self._refresh_all();
				});
			});

			content.find("#goh-back-to-analysis").on("click", () => {
				// Force reset analysis_confirmed to go back
				frappe.db.set_value("Service Request", d.name, "analysis_confirmed", 0).then(() => {
					self._load_detail(d.name);
				});
			});
		}

		// ── Solutions events ──
		if (d.ops_stage === "solutions") {
			this._load_solutions_for_categories(d);

			content.find("#goh-save-solutions").on("click", () => {
				const selected = [];
				this.parent.find(".goh-sol-check:checked").each(function () {
					selected.push({
						repair_solution: $(this).data("solution"),
						issue_category:  $(this).data("category"),
						solution_code:   $(this).data("code"),
						estimated_minutes: parseInt($(this).data("minutes") || 0),
						requires_spare:  $(this).data("requires-spare") == "1" ? 1 : 0,
						auto_add_spares: parseInt($(this).data("auto-spares") || 0),
					});
				});

				if (!selected.length) {
					frappe.show_alert({ message: __("Select at least one solution."), indicator: "orange" });
					return;
				}

				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.save_solution_assignment", {
					sr_name: d.name,
					solutions_json: JSON.stringify(selected),
				}).then(() => {
					frappe.show_alert({ message: __("Solutions assigned. Assign a technician."), indicator: "green" });
					self._refresh_all();
				});
			});
		}

		// ── Assign events ──
		if (d.ops_stage === "assign") {
			this._init_technician_field();

			content.find("#goh-do-assign").on("click", () => {
				const technician = this._tech_field && this._tech_field.get_value();
				if (!technician) {
					frappe.show_alert({ message: __("Please select a technician."), indicator: "orange" });
					return;
				}
				const job_type = content.find("#goh-job-type").val() || "Repair";
				const est_hours = parseFloat(content.find("#goh-est-hours").val() || 2);

				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.assign_technician", {
					sr_name: d.name,
					technician: technician,
					job_type: job_type,
					estimated_hours: est_hours,
				}).then(() => {
					frappe.show_alert({ message: __("Technician assigned. Repair started!"), indicator: "green" });
					self._refresh_all();
				}).catch(err => {
					frappe.msgprint({
						title: __("Assignment Failed"),
						indicator: "red",
						message: frappe.utils.strip_html((err && err.message) || String(err)),
					});
				});
			});
		}

		// ── Repair events ──
		if (d.ops_stage === "repair") {
			// Submit for QC button
			content.find("#goh-submit-qc").on("click", () => {
				frappe.confirm(
					__("Submit all solutions for QC? This will mark remaining solutions as Completed and trigger quality check."),
					() => {
						frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.submit_for_qc", {
							sr_name: d.name,
						}).then(() => {
							frappe.show_alert({ message: __("Submitted for QC!"), indicator: "green" });
							self._refresh_all();
						});
					}
				);
			});

			// Solution status buttons
			content.on("click", ".goh-sol-inprogress", function () {
				const rowName = $(this).data("row");
				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.update_solution_status", {
					sr_name: d.name, solution_row_name: rowName, status: "In Progress",
				}).then(() => self._load_detail(d.name));
			});

			content.on("click", ".goh-sol-complete", function () {
				const rowName = $(this).data("row");
				const dlg = new frappe.ui.Dialog({
					title: __("Mark Solution Complete"),
					fields: [{ fieldname: "remarks", label: __("Technician Remarks"), fieldtype: "Small Text" }],
					primary_action_label: __("Mark Done"),
					primary_action: vals => {
						frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.update_solution_status", {
							sr_name: d.name, solution_row_name: rowName, status: "Completed",
							remarks: vals.remarks || "",
						}).then(() => { dlg.hide(); self._load_detail(d.name); });
					},
				});
				dlg.show();
			});

			content.on("click", ".goh-sol-skip", function () {
				const rowName = $(this).data("row");
				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.update_solution_status", {
					sr_name: d.name, solution_row_name: rowName, status: "Skipped",
				}).then(() => self._load_detail(d.name));
			});

			// Add spare part
			content.find("#goh-add-spare-btn").on("click", () => {
				const dlg = new frappe.ui.Dialog({
					title: __("Add Spare Part"),
					fields: [
						{ fieldname: "spare_item", label: __("Spare Part"), fieldtype: "Link", options: "Item", reqd: 1 },
						{ fieldname: "qty", label: __("Qty"), fieldtype: "Float", default: 1, reqd: 1 },
						{ fieldname: "rate", label: __("Rate (₹)"), fieldtype: "Currency", default: 0 },
					],
					primary_action_label: __("Add"),
					primary_action: vals => {
						frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.add_spare_to_ticket", {
							sr_name: d.name,
							spare_item: vals.spare_item,
							qty: vals.qty,
							rate: vals.rate || 0,
						}).then(() => { dlg.hide(); self._load_detail(d.name); });
					},
				});
				dlg.show();
			});

			// Handoff
			content.find("#goh-handoff-btn").on("click", () => {
				const dlg = new frappe.ui.Dialog({
					title: __("Hand Off to Another Technician"),
					fields: [
						{ fieldname: "new_technician", label: __("New Technician"), fieldtype: "Link", options: "Employee", reqd: 1 },
						{ fieldname: "job_type", label: __("Job Type"), fieldtype: "Select",
						  options: "Repair\nDiagnosis\nSpare Parts Replacement\nSoftware Update\nTesting",
						  default: "Repair" },
						{ fieldname: "reason", label: __("Reason for Handoff"), fieldtype: "Small Text" },
					],
					primary_action_label: __("Hand Off"),
					primary_action: vals => {
						frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.handoff_to_technician", {
							sr_name: d.name,
							new_technician: vals.new_technician,
							job_type: vals.job_type || "Repair",
							reason: vals.reason || "",
						}).then(() => { dlg.hide(); self._load_detail(d.name); frappe.show_alert({ message: __("Handed off."), indicator: "green" }); });
					},
				});
				dlg.show();
			});
		}

		// ── QC events ──
		if (d.ops_stage === "qc") {
			// Save QC checklist results
			content.find("#goh-save-qc").on("click", () => {
				const checklist = [];
				this.parent.find("#goh-qc-table tbody tr").each(function () {
					checklist.push({
						name: $(this).data("name"),
						check_name: $(this).find(".goh-qc-result").data("check"),
						result: $(this).find(".goh-qc-result").val(),
						remarks: $(this).find(".goh-qc-remarks").val() || "",
					});
				});
				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.save_qc_results", {
					sr_name: d.name,
					checklist_json: JSON.stringify(checklist),
				}).then(() => {
					frappe.show_alert({ message: __("QC results saved."), indicator: "green" });
				});
			});

			// QC Pass
			content.find("#goh-qc-pass").on("click", () => {
				frappe.confirm(
					__("Mark QC as <b>Pass</b>? This will send the ticket to invoicing."),
					() => {
						frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.complete_qc", {
							sr_name: d.name, qc_result: "Pass",
						}).then(() => {
							frappe.show_alert({ message: __("QC Passed! Ticket sent to Invoice."), indicator: "green" });
							self._refresh_all();
						});
					}
				);
			});

			// QC Fail
			content.find("#goh-qc-fail").on("click", () => {
				frappe.confirm(
					__("Mark QC as <b>Fail</b>? Floor manager will need to review and reassign."),
					() => {
						frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.complete_qc", {
							sr_name: d.name, qc_result: "Fail",
						}).then(() => {
							frappe.show_alert({ message: __("QC Failed. Ticket moved to Rework."), indicator: "red" });
							self._refresh_all();
						});
					}
				);
			});
		}

		// ── Invoice events ──
		if (d.ops_stage === "invoice") {
			// Load billing summary
			frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.get_invoice_summary", {
				sr_name: d.name,
			}).then(summary => {
				const esc = frappe.utils.escape_html;
				const svcRows = (summary.service_items || []).map(i => `
					<tr>
						<td>${esc(i.item_name || i.item_code)}</td>
						<td class="text-right">${i.qty}</td>
						<td class="text-right">₹${frappe.utils.fmt_money(i.rate)}</td>
						<td class="text-right">₹${frappe.utils.fmt_money(i.amount)}</td>
					</tr>
				`).join("");

				const spareRows = (summary.spare_items || []).map(i => `
					<tr>
						<td>${esc(i.item_name || i.item_code)}</td>
						<td class="text-right">${i.qty}</td>
						<td class="text-right">₹${frappe.utils.fmt_money(i.rate)}</td>
						<td class="text-right">₹${frappe.utils.fmt_money(i.amount)}</td>
					</tr>
				`).join("");

				const warrantyBadge = summary.warranty_status
					? `<span class="goh-badge ${summary.warranty_status === "Under Warranty" ? "goh-badge-green" : "goh-badge-muted"} ml-2">${esc(summary.warranty_status)}</span>`
					: "";

				this.parent.find("#goh-invoice-summary").html(`
					<div class="goh-step-section-title">
						<i class="fa fa-file-text-o"></i> ${__("Billing Summary")} ${warrantyBadge}
					</div>

					${svcRows ? `
						<h6 class="mt-2">${__("Service Charges")}</h6>
						<table class="goh-table">
							<thead><tr><th>${__("Item")}</th><th class="text-right">${__("Qty")}</th><th class="text-right">${__("Rate")}</th><th class="text-right">${__("Amount")}</th></tr></thead>
							<tbody>${svcRows}</tbody>
							<tfoot><tr><td colspan="3" class="text-right"><b>${__("Service Total")}</b></td><td class="text-right"><b>₹${frappe.utils.fmt_money(summary.service_total)}</b></td></tr></tfoot>
						</table>
					` : ""}

					${spareRows ? `
						<h6 class="mt-3">${__("Spare Parts")}</h6>
						<table class="goh-table">
							<thead><tr><th>${__("Item")}</th><th class="text-right">${__("Qty")}</th><th class="text-right">${__("Rate")}</th><th class="text-right">${__("Amount")}</th></tr></thead>
							<tbody>${spareRows}</tbody>
							<tfoot><tr><td colspan="3" class="text-right"><b>${__("Spare Total")}</b></td><td class="text-right"><b>₹${frappe.utils.fmt_money(summary.spare_total)}</b></td></tr></tfoot>
						</table>
					` : ""}

					${summary.discount ? `
						<div class="goh-invoice-discount mt-2 text-muted">
							${__("Discount")}: <b>-₹${frappe.utils.fmt_money(summary.discount)}</b>
						</div>
					` : ""}

					<div class="goh-invoice-grand-total mt-3">
						<h4>${__("Grand Total")}: <span style="color:#10b981;">₹${frappe.utils.fmt_money(summary.grand_total)}</span></h4>
					</div>

					${summary.service_invoice ? `
						<div class="mt-2">
							<span class="goh-badge goh-badge-green">${__("Invoice Created")}</span>
							<a href="/desk/sales-invoice/${encodeURIComponent(summary.service_invoice)}" target="_blank" class="ml-2">
								${esc(summary.service_invoice)}
							</a>
						</div>
					` : `<p class="text-muted mt-2">${__("Invoice will be created at POS during handover.")}</p>`}
				`);
			});
		}

		// ── Rework events ──
		if (d.ops_stage === "rework") {
			// Initialize technician Link field in rework section
			const techWrapper = this.parent.find("#goh-rework-tech-field");
			if (techWrapper.length) {
				this._rework_tech_field = frappe.ui.form.make_control({
					df: {
						fieldname: "rework_technician",
						fieldtype: "Link",
						options: "Employee",
						label: __("Technician"),
						placeholder: __("Select technician..."),
						get_query: () => ({
							filters: { "status": "Active", "department": ["like", "%Service%"] },
						}),
					},
					parent: techWrapper,
					render_input: true,
				});
			}

			content.find("#goh-rework-assign").on("click", () => {
				const technician = this._rework_tech_field && this._rework_tech_field.get_value();
				if (!technician) {
					frappe.show_alert({ message: __("Please select a technician."), indicator: "orange" });
					return;
				}
				const job_type = content.find("#goh-rework-job-type").val() || "Repair";
				const manager_notes = content.find("#goh-rework-notes").val() || "";

				frappe.xcall("gofix.gofix_services.page.gofix_ops_hub.gofix_ops_hub.reassign_after_qc_fail", {
					sr_name: d.name,
					technician: technician,
					job_type: job_type,
					manager_notes: manager_notes,
				}).then(res => {
					frappe.show_alert({ message: __("Reassigned to technician. Ticket back in Repair."), indicator: "green" });
					self._refresh_all();
				});
			});
		}
	}

	// ── Helpers ────────────────────────────────────────────────────────────────

	_collect_issues() {
		const issues = [];
		this.parent.find("#goh-issue-tbody tr").each(function () {
			const cat = $(this).find(".goh-issue-cat").val().trim();
			if (!cat) return;
			issues.push({
				issue_category: cat,
				reported_by:    $(this).find(".goh-issue-reporter").val() || "Technician",
				description:    $(this).find(".goh-issue-desc").val().trim(),
				status:         "Open",
			});
		});
		return issues;
	}
}
